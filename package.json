{
  "name": "selenium-electron-app",
  "version": "1.0.0",
  "description": "Electron app with Selenium WebDriver automation",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "dev": "concurrently \"npm run watch-ts\" \"npm run start-dev\"",
    "watch-ts": "tsc -w",
    "start-dev": "NODE_ENV=development nodemon --watch dist --exec electron .",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chromedriver": "^134.0.5",
    "geckodriver": "^5.0.0",
    "selenium-webdriver": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/selenium-webdriver": "^4.1.21",
    "concurrently": "^9.1.2",
    "electron": "^29.1.0",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
